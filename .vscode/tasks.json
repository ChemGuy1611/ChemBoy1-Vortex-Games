{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "oxlint: Lint All",
      "type": "shell",
      "command": "npx oxlint -f unix",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "oxlint",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+) \\[(Error|Warning)(?:/(.+))?\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": 5,
          "code": 6
        }
      }
    },
    {
      "label": "oxlint: Fix All",
      "type": "shell",
      "command": "npx oxlint -f unix --fix",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "oxlint",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+) \\[(Error|Warning)(?:/(.+))?\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": 5,
          "code": 6
        }
      }
    },
    {
      "label": "oxlint: Lint Current File",
      "type": "shell",
      "command": "npx oxlint -f unix \"${relativeFile}\"",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "oxlint",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+) \\[(Error|Warning)(?:/(.+))?\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": 5,
          "code": 6
        }
      }
    }
  ]
}
